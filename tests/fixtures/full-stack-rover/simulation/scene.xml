<mujoco model="robot-rover-scene">
  <compiler angle="radian" />
  <option
    timestep="0.01"
    gravity="0 0 -9.81"
    integrator="implicitfast"
    solver="Newton"
  />
  <!-- Synthetic origin for this sandbox scene, not a physical deployment. -->
  <custom>
    <numeric name="phoxal_georeference" data="0 0 0 0 0 0 0" />
    <text name="phoxal_georeference_axes" data="ENU" />
    <text name="phoxal_georeference_datum" data="WGS84_ELLIPSOIDAL" />
  </custom>
  <statistic center="0 0 0.25" extent="1.4" />
  <visual>
    <global offwidth="1280" offheight="960" azimuth="135" elevation="-25" />
    <headlight ambient="0.3 0.3 0.3" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2" />
    <rgba haze="0.7 0.8 0.9 1" />
  </visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.7 0.85" rgb2="0.9 0.95 1" width="512" height="3072" />
    <texture name="floor-grid" type="2d" builtin="checker" rgb1="0.7 0.74 0.78" rgb2="0.55 0.6 0.65" width="512" height="512" />
    <material name="floor" texture="floor-grid" texrepeat="2 2" texuniform="true" reflectance="0" />
  </asset>
  <worldbody>
    <light pos="0 -3 5" dir="0 0.5 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" />
    <site name="robot_mount" pos="0 0 0" size="0.002" />
    <geom
      name="ground"
      type="plane"
      material="floor"
      size="20 20 0.1"
      friction="1 0.5 0.5"
    />
  </worldbody>
</mujoco>
